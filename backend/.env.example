# Database
DATABASE_URL=postgresql://cronhub:cronhub_secret@localhost:5432/cronhub
DATABASE_SSL=false

# Auth
JWT_SECRET=change_this_to_a_long_random_secret_in_production
SECRETS_ENCRYPTION_KEY=change_this_to_a_different_long_random_secret

# Server
PORT=3004
NODE_ENV=development
FRONTEND_URL=http://localhost:5176
APP_URL=http://localhost:5176

# Email alerts (optional — leave SMTP_HOST blank to disable)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=CronHub <your@gmail.com>
